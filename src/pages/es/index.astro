---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = 'Pasteles de Elizabeth | Pasteles personalizados por encargo';
const description =
  'Elizabeth crea pasteles personalizados para cumpleaños, bodas, quinceañeras y eventos familiares. Envía tu idea, fecha y número de porciones para recibir una cotización.';

const steps = [
  { title: 'Envía tu solicitud', detail: 'Cuéntanos tu idea, la fecha del evento y el número de porciones.' },
  { title: 'Revisamos disponibilidad', detail: 'Confirmamos si tenemos espacio para tu fecha y los detalles del pastel.' },
  { title: 'Recibes cotización', detail: 'Te enviamos un precio estimado según el diseño, tamaño y los ingredientes.' },
  { title: 'Confirmas tu pedido', detail: 'Acordamos los últimos detalles y reservamos tu fecha.' },
  { title: 'Recoges tu pastel', detail: 'Te compartimos el lugar y la hora de recogida acordada.' }
];

const categories = [
  { title: 'Cumpleaños', detail: 'Pasteles temáticos para niños y adultos.' },
  { title: 'Bodas', detail: 'Diseños elegantes para tu celebración.' },
  { title: 'Quinceañeras', detail: 'Pasteles especiales para los quince años.' },
  { title: 'Eventos familiares', detail: 'Bautizos, aniversarios y reuniones.' }
];
---
<BaseLayout lang="es" title={pageTitle} description={description}>
  <!-- 1. Hero -->
  <section class="mx-auto flex max-w-5xl flex-col items-center gap-6 px-4 py-16 text-center sm:py-20">
    <span class="inline-flex items-center justify-center rounded-full bg-brand-100 px-4 py-1 text-sm font-semibold text-brand-700">
      Pasteles por encargo
    </span>
    <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
      Pasteles hechos por encargo para cumpleaños, bodas y celebraciones
    </h1>
    <p class="max-w-2xl text-lg text-gray-600">{description}</p>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a
        href="/es/contacto/"
        class="inline-flex items-center justify-center rounded-full bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2"
      >
        Solicitar cotización
      </a>
      <a
        href="/es/galeria/"
        class="inline-flex items-center justify-center rounded-full border border-brand-300 bg-white px-6 py-3 text-sm font-semibold text-brand-700 transition hover:border-brand-400 hover:text-brand-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2"
      >
        Ver galería
      </a>
    </div>
  </section>

  <!-- 2. Cómo funciona el pedido -->
  <section class="border-t border-gray-200 bg-white/60">
    <div class="mx-auto flex max-w-5xl flex-col gap-10 px-4 py-16">
      <header class="space-y-3 text-center">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900">Cómo funciona el pedido</h2>
        <p class="text-gray-600">Un proceso sencillo desde tu idea hasta la recogida de tu pastel.</p>
      </header>
      <ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
        {steps.map((step, index) => (
          <li class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-100 text-sm font-bold text-brand-700">
              {index + 1}
            </span>
            <h3 class="mt-4 text-base font-semibold text-gray-900">{step.title}</h3>
            <p class="mt-2 text-sm text-gray-600">{step.detail}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 3. Política de recogida -->
  <section class="mx-auto max-w-5xl px-4 py-16">
    <div class="rounded-2xl border border-brand-200 bg-brand-50 p-8">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900">Recogida con cita previa</h2>
      <p class="mt-4 max-w-3xl text-gray-700">
        La mayoría de los pedidos son para recogida. Después de confirmar tu pedido, recibirás los detalles de
        recogida y la hora acordada. La entrega puede estar disponible en casos especiales, dependiendo de la
        ubicación, fecha, tamaño del pastel y disponibilidad. La entrega no está garantizada y puede tener costo
        adicional.
      </p>
    </div>
  </section>

  <!-- 4. Categorías de pasteles -->
  <section class="border-t border-gray-200 bg-white/60">
    <div class="mx-auto flex max-w-5xl flex-col gap-10 px-4 py-16">
      <header class="space-y-3 text-center">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900">Tipos de pasteles</h2>
        <p class="text-gray-600">Cada pastel se diseña a la medida de tu celebración.</p>
      </header>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {categories.map((category) => (
          <article class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-semibold text-gray-900">{category.title}</h3>
            <p class="mt-2 text-sm text-gray-600">{category.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. CTA final -->
  <section class="mx-auto max-w-5xl px-4 py-16">
    <div class="flex flex-col items-center gap-6 rounded-2xl bg-brand-600 px-6 py-12 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white">¿Lista o listo para tu pastel?</h2>
      <p class="max-w-2xl text-brand-50">
        Envía tu idea, fecha y número de porciones y prepararemos una cotización para tu celebración.
      </p>
      <a
        href="/es/contacto/"
        class="inline-flex items-center justify-center rounded-full bg-white px-6 py-3 text-sm font-semibold text-brand-700 shadow-sm transition hover:bg-brand-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-brand-600"
      >
        Solicitar cotización
      </a>
    </div>
  </section>
</BaseLayout>
