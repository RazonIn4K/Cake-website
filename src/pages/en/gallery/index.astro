---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GalleryCard from '../../../components/gallery/gallery-card.astro';
import { assertTranslationCoverage, resolveLocalizedEntry } from '../../../content/utils';

const allGallery = await getCollection('gallery');
assertTranslationCoverage(allGallery);

const reference = allGallery
  .filter((entry) => (entry.data.locale ?? 'es') === 'es')
  .sort((a, b) => {
    if ((b.data.featured ? 1 : 0) !== (a.data.featured ? 1 : 0)) {
      return (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0);
    }
    return a.data.title.localeCompare(b.data.title, 'es');
  });

const items = await Promise.all(
  reference.map(async (item) => {
    const localized = resolveLocalizedEntry(allGallery, { slug: item.slug, locale: 'en' }) ?? item;
    const { Content } = await localized.render();
    return { item: localized, Content };
  })
);
---
<BaseLayout lang="en" title="Cake gallery" description="Preview custom cakes Elizabeth has created for birthdays, weddings, and celebrations.">
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16">
    <header class="max-w-2xl">
      <span class="lg-tag bg-pink-soft text-ink">🎂 Gallery</span>
      <h1 class="mt-4 font-display text-4xl font-extrabold text-ink sm:text-5xl">Gallery</h1>
      <p class="mt-3 text-lg font-semibold text-ink-soft">
        A look at custom cakes designed for birthdays, weddings, and family celebrations.
      </p>
    </header>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {items.map(({ item, Content }) => (
        <GalleryCard item={item} locale="en">
          <Content slot="description" />
        </GalleryCard>
      ))}
    </div>
  </section>
</BaseLayout>
