---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = 'Elizabeth’s Cakes | Made-to-order custom cakes';
const description =
  'Elizabeth creates custom cakes for birthdays, weddings, quinceañeras, and family events. Send your idea, date, and serving count to request a quote.';

const steps = [
  { title: 'Send your request', detail: 'Tell us your idea, the event date, and how many servings you need.' },
  { title: 'We check availability', detail: 'We confirm whether we have room for your date and cake details.' },
  { title: 'You receive a quote', detail: 'We send an estimated price based on the design, size, and ingredients.' },
  { title: 'You confirm your order', detail: 'We agree on the final details and reserve your date.' },
  { title: 'Pick up your cake', detail: 'We share the agreed pickup location and time.' }
];

const categories = [
  { title: 'Birthdays', detail: 'Themed cakes for kids and adults.' },
  { title: 'Weddings', detail: 'Elegant designs for your celebration.' },
  { title: 'Quinceañeras', detail: 'Special cakes for the fifteenth birthday.' },
  { title: 'Family events', detail: 'Baptisms, anniversaries, and gatherings.' }
];
---
<BaseLayout lang="en" title={pageTitle} description={description}>
  <!-- 1. Hero -->
  <section class="mx-auto flex max-w-5xl flex-col items-center gap-6 px-4 py-16 text-center sm:py-20">
    <span class="inline-flex items-center justify-center rounded-full bg-brand-100 px-4 py-1 text-sm font-semibold text-brand-700">
      Made-to-order cakes
    </span>
    <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
      Made-to-order cakes for birthdays, weddings, and celebrations
    </h1>
    <p class="max-w-2xl text-lg text-gray-600">{description}</p>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a
        href="/en/contact/"
        class="inline-flex items-center justify-center rounded-full bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2"
      >
        Request quote
      </a>
      <a
        href="/en/gallery/"
        class="inline-flex items-center justify-center rounded-full border border-brand-300 bg-white px-6 py-3 text-sm font-semibold text-brand-700 transition hover:border-brand-400 hover:text-brand-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2"
      >
        View gallery
      </a>
    </div>
  </section>

  <!-- 2. How ordering works -->
  <section class="border-t border-gray-200 bg-white/60">
    <div class="mx-auto flex max-w-5xl flex-col gap-10 px-4 py-16">
      <header class="space-y-3 text-center">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900">How ordering works</h2>
        <p class="text-gray-600">A simple process from your idea to picking up your cake.</p>
      </header>
      <ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
        {steps.map((step, index) => (
          <li class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-100 text-sm font-bold text-brand-700">
              {index + 1}
            </span>
            <h3 class="mt-4 text-base font-semibold text-gray-900">{step.title}</h3>
            <p class="mt-2 text-sm text-gray-600">{step.detail}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 3. Pickup policy -->
  <section class="mx-auto max-w-5xl px-4 py-16">
    <div class="rounded-2xl border border-brand-200 bg-brand-50 p-8">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900">Pickup by appointment</h2>
      <p class="mt-4 max-w-3xl text-gray-700">
        Most orders are pickup by appointment. After your order is confirmed, you will receive the pickup details and agreed
        pickup time. Delivery may be available in special cases depending on location, date, cake size, and
        availability. Delivery is not guaranteed and may include an additional fee.
      </p>
    </div>
  </section>

  <!-- 4. Cake categories -->
  <section class="border-t border-gray-200 bg-white/60">
    <div class="mx-auto flex max-w-5xl flex-col gap-10 px-4 py-16">
      <header class="space-y-3 text-center">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900">Cake types</h2>
        <p class="text-gray-600">Every cake is designed to fit your celebration.</p>
      </header>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {categories.map((category) => (
          <article class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-semibold text-gray-900">{category.title}</h3>
            <p class="mt-2 text-sm text-gray-600">{category.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Final CTA -->
  <section class="mx-auto max-w-5xl px-4 py-16">
    <div class="flex flex-col items-center gap-6 rounded-2xl bg-brand-600 px-6 py-12 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white">Ready for your cake?</h2>
      <p class="max-w-2xl text-brand-50">
        Send your idea, date, and serving count and we will prepare a quote for your celebration.
      </p>
      <a
        href="/en/contact/"
        class="inline-flex items-center justify-center rounded-full bg-white px-6 py-3 text-sm font-semibold text-brand-700 shadow-sm transition hover:bg-brand-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-brand-600"
      >
        Request quote
      </a>
    </div>
  </section>
</BaseLayout>
