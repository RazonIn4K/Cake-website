---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = 'Elizabeth’s Cakes | Made-to-order custom cakes';
const description =
  'Elizabeth creates custom cakes for birthdays, weddings, quinceañeras, and family events. Send your idea, date, and serving count to request a quote.';

const steps = [
  { title: 'Send your request', detail: 'Tell us your idea, the event date, and how many servings you need.', color: 'bg-sun' },
  { title: 'We check availability', detail: 'We confirm whether we have room for your date and cake details.', color: 'bg-coral' },
  { title: 'You receive a quote', detail: 'We send an estimated price based on the design, size, and ingredients.', color: 'bg-pink' },
  { title: 'You confirm your order', detail: 'We agree on the final details and reserve your date.', color: 'bg-teal' },
  { title: 'Pick up your cake', detail: 'We share the agreed pickup location and time.', color: 'bg-sky' }
];

const categories = [
  { title: 'Birthdays', detail: 'Themed cakes for kids and adults.', emoji: '🎉', color: 'bg-pink-soft' },
  { title: 'Weddings', detail: 'Elegant designs for your celebration.', emoji: '💍', color: 'bg-sky-soft' },
  { title: 'Quinceañeras', detail: 'Special cakes for the fifteenth birthday.', emoji: '👑', color: 'bg-violet-soft' },
  { title: 'Family events', detail: 'Baptisms, anniversaries, and gatherings.', emoji: '🎈', color: 'bg-lime-soft' }
];
---
<BaseLayout lang="en" title={pageTitle} description={description}>
  <!-- 1. Hero -->
  <section class="relative overflow-hidden">
    <span class="pointer-events-none absolute left-[7%] top-14 text-3xl sm:text-4xl" aria-hidden="true">✨</span>
    <span class="pointer-events-none absolute right-[9%] top-24 text-2xl sm:text-3xl" aria-hidden="true">⭐</span>
    <span class="pointer-events-none absolute left-[13%] bottom-8 text-2xl sm:text-3xl" aria-hidden="true">💗</span>
    <span class="pointer-events-none absolute right-[13%] bottom-14 text-2xl sm:text-3xl" aria-hidden="true">🧁</span>
    <div class="mx-auto flex max-w-4xl flex-col items-center gap-6 px-4 py-16 text-center sm:py-24">
      <span class="lg-tag bg-sun text-ink shadow-sticker-sm">✨ Made-to-order cakes</span>
      <h1 class="font-display text-4xl font-extrabold leading-[1.05] text-ink sm:text-6xl">
        Made-to-order cakes for birthdays, weddings, and
        <span class="relative inline-block">
          <span class="relative z-10">celebrations</span>
          <span class="absolute inset-x-0 bottom-1 z-0 h-3 rounded-full bg-sun sm:h-4" aria-hidden="true"></span>
        </span>
      </h1>
      <p class="max-w-2xl text-lg font-semibold text-ink-soft">{description}</p>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href="/en/contact/" class="lg-btn bg-coral px-7 py-3.5 text-lg text-ink">Request quote →</a>
        <a href="/en/gallery/" class="lg-btn bg-paper px-7 py-3.5 text-lg text-ink">View gallery</a>
      </div>
    </div>
  </section>

  <!-- 2. How ordering works -->
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <header class="mx-auto mb-10 max-w-2xl text-center">
      <span class="lg-tag bg-teal-soft text-ink">How it works</span>
      <h2 class="mt-4 font-display text-3xl font-extrabold text-ink sm:text-4xl">How ordering works</h2>
      <p class="mt-3 font-semibold text-ink-soft">A simple process from your idea to picking up your cake.</p>
    </header>
    <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
      {steps.map((step, i) => (
        <li class="lg-card p-6">
          <span class={`lg-num ${step.color} text-ink`}>{i + 1}</span>
          <h3 class="mt-4 font-display text-lg font-bold text-ink">{step.title}</h3>
          <p class="mt-2 text-sm font-medium text-ink-soft">{step.detail}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- 3. Pickup policy -->
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <div class="lg-card bg-sky-soft p-8 sm:p-10">
      <span class="lg-tag bg-paper text-ink">📍 Pickup</span>
      <h2 class="mt-4 font-display text-2xl font-extrabold text-ink sm:text-3xl">Pickup by appointment</h2>
      <p class="mt-4 max-w-3xl text-base font-semibold text-ink-soft">
        Most orders are pickup by appointment. After your order is confirmed, you will receive the pickup details and
        agreed pickup time. Delivery may be available in special cases depending on location, date, cake size, and
        availability. Delivery is not guaranteed and may include an additional fee.
      </p>
    </div>
  </section>

  <!-- 4. Cake categories -->
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <header class="mx-auto mb-10 max-w-2xl text-center">
      <span class="lg-tag bg-pink-soft text-ink">Cake types</span>
      <h2 class="mt-4 font-display text-3xl font-extrabold text-ink sm:text-4xl">For every celebration</h2>
      <p class="mt-3 font-semibold text-ink-soft">Every cake is designed to fit your event.</p>
    </header>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {categories.map((c) => (
        <article class={`lg-card ${c.color} p-6`}>
          <span class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-ink bg-paper text-2xl shadow-sticker-sm" aria-hidden="true">{c.emoji}</span>
          <h3 class="mt-4 font-display text-xl font-bold text-ink">{c.title}</h3>
          <p class="mt-2 text-sm font-medium text-ink-soft">{c.detail}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- 5. Final CTA -->
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="lg-card relative overflow-hidden bg-coral p-10 text-center sm:p-14">
      <span class="pointer-events-none absolute left-8 top-6 text-3xl" aria-hidden="true">✨</span>
      <span class="pointer-events-none absolute right-10 bottom-8 text-3xl" aria-hidden="true">🎂</span>
      <h2 class="font-display text-3xl font-extrabold text-ink sm:text-4xl">Ready for your cake?</h2>
      <p class="mx-auto mt-3 max-w-2xl text-base font-semibold text-ink">
        Send your idea, date, and serving count and we will prepare a quote for your celebration.
      </p>
      <a href="/en/contact/" class="lg-btn mt-7 bg-paper px-8 py-4 text-lg text-ink">Request quote →</a>
    </div>
  </section>
</BaseLayout>
