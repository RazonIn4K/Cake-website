---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CakeGalleryHero from '../../components/CakeGalleryHero.astro';
import LocalBusinessInfo from '../../components/LocalBusinessInfo.astro';
import TestimonialsSection from '../../components/TestimonialsSection.astro';
import CakeOrderForm from '../../components/CakeOrderForm.astro';
import SecondaryOfferingsSection from '../../components/SecondaryOfferingsSection.astro';

// Fetch collections for local cake business (English versions)
const [cakes, business, testimonials, additionalOfferings] = await Promise.all([
  getCollection('cakes'),
  getCollection('business'),
  getCollection('testimonials'),
  getCollection('additional-offerings'),
]);

// Filter and sort English content
const cakesEn = cakes
  .filter((entry) => entry.id.startsWith('en/'))
  .sort((a, b) => a.data.order - b.data.order);
const businessEn = business.find((entry) => entry.id.startsWith('en/'));
const testimonialsEn = testimonials
  .filter((entry) => entry.id.startsWith('en/'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const additionalOfferingsEn = additionalOfferings
  .filter((entry) => entry.id.startsWith('en/'))
  .sort((a, b) => a.data.order - b.data.order);

---

<Layout
  title="Custom Cakes in Genoa IL | Genoa Artisan Cakes | Wedding & Birthday Cakes"
  description="🎂 Custom artisan cakes in Genoa, Illinois. Specialists in wedding cakes, birthday cakes & celebrations. Delivery across Genoa, Kingston, and Sycamore. ⭐ 4.9/5 stars. Order your cake today."
  lang="en"
>
  <!-- Cake Gallery Hero - Primary Focus -->
  <CakeGalleryHero cakes={cakesEn} lang="en" />

  <!-- Local Business Information - Critical for Local Business -->
  {businessEn && (
    <LocalBusinessInfo businessData={businessEn} lang="en" />
  )}

  <!-- Customer Testimonials - Social Proof -->
  {testimonialsEn.length > 0 && (
    <TestimonialsSection testimonials={testimonialsEn} lang="en" />
  )}

  <!-- Custom Cake Order Form - Primary Conversion Point -->
  <CakeOrderForm lang="en" />

  <!-- Secondary Offerings - Workshops & Digital Products (Clearly Secondary) -->
  {additionalOfferingsEn.length > 0 && (
    <SecondaryOfferingsSection offerings={additionalOfferingsEn} lang="en" />
  )}

  <!-- WhatsApp Community CTA - Final Engagement -->
  <section class="px-6 py-20 bg-gradient-to-br from-cream via-warm-cream to-soft-pink/30 md:px-12">
    <div class="mx-auto max-w-5xl">
      <div class="rounded-3xl border border-gold-accent/40 bg-white/90 p-10 text-center shadow-2xl backdrop-blur-sm md:p-16">
        <div class="text-6xl mb-6">🌟</div>
        <h2 class="text-3xl font-serif font-bold text-warm-brown md:text-4xl mb-4">
          Follow Us on Social Media
        </h2>
        <p class="text-lg text-gray-600 mb-8 max-w-2xl mx-auto">
          Join our community to see our latest creations, receive exclusive tips and stay updated with special promotions.
        </p>
        
        <!-- Social Media Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-6">
          <a
            href="https://wa.me/18155550123?text=Hi,%20I'm%20interested%20in%20ordering%20a%20custom%20cake"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-full bg-emerald-800 px-8 py-3 text-base font-semibold text-white shadow-xl transition-all duration-300 hover:-translate-y-1 hover:bg-emerald-900 hover:shadow-2xl focus:outline-none focus:ring-4 focus:ring-emerald-700"
            aria-label="Contact via WhatsApp"
          >
            <span class="mr-2">💬</span>
            WhatsApp
          </a>
          <a
            href="https://www.facebook.com/genoacakes"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-full bg-blue-600 px-8 py-3 text-base font-semibold text-white shadow-xl transition-all duration-300 hover:-translate-y-1 hover:bg-blue-700 hover:shadow-2xl"
            aria-label="Follow on Facebook"
          >
            <span class="mr-2">📘</span>
            Facebook
          </a>
          <a
            href="https://www.instagram.com/genoacakes"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-full bg-gradient-to-r from-purple-500 to-pink-500 px-8 py-3 text-base font-semibold text-white shadow-xl transition-all duration-300 hover:-translate-y-1 hover:from-purple-600 hover:to-pink-600 hover:shadow-2xl"
            aria-label="Follow on Instagram"
          >
            <span class="mr-2">📷</span>
            Instagram
          </a>
        </div>
        
        <!-- Social Proof -->
        <p class="text-sm text-gray-500">
          Join over 500 followers who already enjoy our creations
        </p>
      </div>
    </div>
  </section>
</Layout>
