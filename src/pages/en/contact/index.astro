---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteRequestForm from '../../../components/QuoteRequestForm.astro';

const pageTitle = 'Request a quote';
const description =
  'Tell us your idea, the event date, and the number of servings so we can prepare a quote for your custom cake.';

const steps = [
  'Send your request',
  'We check availability',
  'You receive a quote',
  'You confirm your order',
  'Pick up your cake'
];
---
<BaseLayout lang="en" title={pageTitle} description={description}>
  <section class="relative mx-auto max-w-3xl px-4 py-14 sm:py-16">
    <span class="pointer-events-none absolute right-[5%] top-10 text-3xl" aria-hidden="true">🧁</span>
    <header class="text-center">
      <span class="lg-tag bg-coral text-ink shadow-sticker-sm">✨ Request a quote</span>
      <h1 class="mt-4 font-display text-4xl font-extrabold text-ink sm:text-5xl">Request a quote</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg font-semibold text-ink-soft">{description}</p>
    </header>

    <div class="mt-10">
      <QuoteRequestForm lang="en" />
    </div>

    <div class="lg-card mt-8 bg-sun-soft p-6 sm:p-8">
      <h2 class="font-display text-xl font-extrabold text-ink">How it works</h2>
      <ol class="mt-4 space-y-2.5">
        {steps.map((step, i) => (
          <li class="flex items-center gap-3">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border-2 border-ink bg-paper font-display text-sm font-extrabold text-ink">{i + 1}</span>
            <span class="font-semibold text-ink-soft">{step}</span>
          </li>
        ))}
      </ol>
    </div>

    <div class="lg-card mt-8 bg-sky-soft p-6 sm:p-8">
      <span class="lg-tag bg-paper text-ink">📍 Pickup</span>
      <h2 class="mt-3 font-display text-xl font-extrabold text-ink">Pickup by appointment</h2>
      <p class="mt-3 font-medium text-ink-soft">
        Most orders are pickup by appointment. After your order is confirmed, you will receive the pickup details and
        agreed pickup time. Delivery may be available in special cases and is not guaranteed.
      </p>
    </div>
  </section>
</BaseLayout>
