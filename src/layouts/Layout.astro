---
export interface Props {
  title: string;
  description: string;
  lang?: 'es' | 'en';
  ogImage?: string;
}

import '../styles/global.css';

const { title, description, lang = 'es', ogImage = '/favicon.svg' } = Astro.props;

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const alternateURL = Astro.site ? (lang === 'es' ? new URL('/en' + Astro.url.pathname, Astro.site) : new URL(Astro.url.pathname.replace('/en', ''), Astro.site)) : '#';
---

<!doctype html>
<html lang={lang} class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Performance Optimizations -->
    <meta name="theme-color" content="#8B4513" />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Poppins:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    
    <!-- Preload Critical Images -->
    <link rel="preload" as="image" href="/images/wedding-cake.jpg" />
    <link rel="preload" as="image" href="/images/chocolate-cake.jpg" />
    <link rel="preload" as="image" href="/images/cupcakes.jpg" />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang={lang === 'es' ? 'en' : 'es'} href={alternateURL} />
    
    <!-- Local SEO Keywords -->
    <meta name="keywords" content={lang === 'es' 
      ? 'pasteles personalizados, repostería artesanal, pasteles de boda, pasteles de cumpleaños, cupcakes, Centro ciudad, Norte ciudad, Sur ciudad, pasteles a domicilio, repostería local, pasteles artesanales, decoración de pasteles, flores de azúcar, buttercream, fondant'
      : 'custom cakes, artisan bakery, wedding cakes, birthday cakes, cupcakes, downtown, north side, south side, cake delivery, local bakery, artisan cakes, cake decoration, sugar flowers, buttercream, fondant'
    } />
    
    <!-- Local Business Info -->
    <meta name="geo.region" content="US-IL" />
    <meta name="geo.placename" content="Genoa, IL" />
    <meta name="geo.position" content="42.0978;-88.6920" />
    <meta name="ICBM" content="42.0978, -88.6920" />
    
    <!-- Business Category -->
    <meta name="business.category" content="Bakery" />
    <meta name="business.type" content="Local Business" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="business.business" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage || '/images/wedding-cake.jpg'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={lang === 'es' ? 'Pasteles artesanales personalizados' : 'Custom artisan cakes'} />
    <meta property="og:site_name" content={lang === 'es' ? 'Repostería Artesanal María' : "María's Artisan Bakery"} />
    <meta property="og:locale" content={lang === 'es' ? 'es_US' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_US'} />
    
    <!-- Business-specific Open Graph -->
    <meta property="business:contact_data:street_address" content="123 Main Street" />
    <meta property="business:contact_data:locality" content="Genoa" />
    <meta property="business:contact_data:region" content="IL" />
    <meta property="business:contact_data:postal_code" content="60135" />
    <meta property="business:contact_data:country_name" content="United States" />
    <meta property="business:hours:day" content="monday" />
    <meta property="business:hours:start" content="09:00" />
    <meta property="business:hours:end" content="18:00" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage || '/images/wedding-cake.jpg'} />
    <meta property="twitter:image:alt" content={lang === 'es' ? 'Pasteles artesanales personalizados' : 'Custom artisan cakes'} />
    <meta property="twitter:site" content="@ReposteriaMaria" />
    <meta property="twitter:creator" content="@ReposteriaMaria" />
    
    <!-- Local Business Structured Data -->
    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": ["LocalBusiness", "Bakery", "FoodEstablishment"],
        "name": lang === "es" ? "Pastelería Artesanal de Genoa" : "Genoa Artisan Cakes",
        "alternateName": lang === "es" ? "Pasteles Personalizados en Genoa, IL" : "Custom Cakes in Genoa, IL",
        "description": lang === "es"
          ? "Pasteles artesanales personalizados para bodas, cumpleaños y celebraciones especiales en Genoa, Illinois."
          : "Custom artisan cakes for weddings, birthdays, and special celebrations in Genoa, Illinois.",
        "url": canonicalURL?.toString() ?? Astro.url.toString(),
        "telephone": "+1-815-555-0123",
        "email": "orders@genoacakes.com",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "123 W Main Street",
          "addressLocality": "Genoa",
          "addressRegion": "IL",
          "postalCode": "60135",
          "addressCountry": "US"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": "42.0978",
          "longitude": "-88.6920"
        },
        "openingHours": [
          "Mo 09:00-18:00",
          "Tu 09:00-18:00",
          "We 09:00-18:00",
          "Th 09:00-18:00",
          "Fr 09:00-19:00",
          "Sa 10:00-16:00"
        ],
        "priceRange": "$30-$200",
        "currenciesAccepted": "USD",
        "paymentAccepted": "Cash, Credit Card",
        "areaServed": [
          "Genoa, Illinois",
          "Kingston, Illinois",
          "Sycamore, Illinois",
          "DeKalb County, Illinois"
        ],
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": lang === "es" ? "Pasteles Personalizados" : "Custom Cakes",
          "itemListElement": [
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Product",
                "name": lang === "es" ? "Pasteles de Boda" : "Wedding Cakes",
                "description": lang === "es"
                  ? "Pasteles de boda personalizados con flores de azúcar hechas a mano"
                  : "Custom wedding cakes with handcrafted sugar flowers"
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Product",
                "name": lang === "es" ? "Pasteles de Cumpleaños" : "Birthday Cakes",
                "description": lang === "es"
                  ? "Pasteles de cumpleaños personalizados con decoración temática"
                  : "Custom birthday cakes with themed decoration"
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Product",
                "name": lang === "es" ? "Cupcakes Artesanales" : "Artisan Cupcakes",
                "description": lang === "es"
                  ? "Cupcakes artesanales con buttercream personalizado"
                  : "Artisan cupcakes with personalized buttercream"
              }
            }
          ]
        },
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "4.9",
          "reviewCount": "128"
        },
        "image": [
          `${Astro.site ?? ''}/images/cakes/elegant-wedding-cake.jpg`,
          `${Astro.site ?? ''}/images/chocolate-cake.jpg`,
          `${Astro.site ?? ''}/images/cupcakes.jpg`
        ],
        "logo": `${Astro.site ?? ''}/favicon.svg`,
        "sameAs": [
          "https://www.facebook.com/genoacakes",
          "https://www.instagram.com/genoacakes",
          "https://wa.me/18155550123"
        ]
      })}
    </script>
  </head>
  <body class="min-h-full bg-cream text-text-primary font-sans antialiased">
    <!-- Skip Navigation Links -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-warm-brown text-white px-4 py-2 rounded-md z-50">
      {lang === 'es' ? 'Saltar al contenido principal' : 'Skip to main content'}
    </a>
    <a href="#cake-gallery" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-40 bg-warm-brown text-white px-4 py-2 rounded-md z-50">
      {lang === 'es' ? 'Ir a galería de pasteles' : 'Go to cake gallery'}
    </a>
    <a href="#business-info" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-80 bg-warm-brown text-white px-4 py-2 rounded-md z-50">
      {lang === 'es' ? 'Ir a información del negocio' : 'Go to business information'}
    </a>

    <main id="main-content" class="relative min-h-screen" role="main">
      <!-- Language Switcher -->
      <div class="fixed top-4 right-4 z-50">
        {lang === 'es' ? (
          <a
            href="/en/"
            class="inline-flex items-center gap-2 rounded-full border border-gold-accent bg-white/90 px-4 py-2 text-sm font-medium text-warm-brown shadow-lg transition-all duration-200 hover:-translate-y-0.5 hover:bg-white hover:shadow-xl"
          >
            🇺🇸 English
          </a>
        ) : (
          <a
            href="/"
            class="inline-flex items-center gap-2 rounded-full border border-gold-accent bg-white/90 px-4 py-2 text-sm font-medium text-warm-brown shadow-lg transition-all duration-200 hover:-translate-y-0.5 hover:bg-white hover:shadow-xl"
          >
            🇲🇽 Español
          </a>
        )}
      </div>

      <div class="relative z-10">
        <slot />
      </div>

      <!-- Soft background accent -->
      <div class="pointer-events-none fixed inset-0 -z-10 bg-gradient-to-br from-warm-cream via-cream to-soft-pink opacity-80"></div>
    </main>

    <style>
      /* Screen reader only content */
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      /* Show skip links on focus */
      .focus\:not-sr-only:focus {
        position: static;
        width: auto;
        height: auto;
        padding: 0.5rem 1rem;
        margin: 0;
        overflow: visible;
        clip: auto;
        white-space: normal;
      }

      /* High contrast mode support */
      @media (prefers-contrast: high) {
        body {
          background: white;
          color: black;
        }
      }

      /* Reduced motion support */
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </body>
</html>
