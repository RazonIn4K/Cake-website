---
import '../styles/global.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

interface Props {
  lang?: 'es' | 'en';
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  lang = 'es',
  title,
  description,
  noindex = false,
  canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined
} = Astro.props as Props;

const brand = lang === 'es' ? 'Pasteles de Elizabeth' : 'Elizabeth’s Cakes';

const defaultTitle =
  lang === 'es'
    ? 'Pasteles de Elizabeth | Pasteles personalizados por encargo'
    : 'Elizabeth’s Cakes | Made-to-order custom cakes';

const defaultDescription =
  lang === 'es'
    ? 'Elizabeth crea pasteles personalizados para cumpleaños, bodas, quinceañeras y eventos familiares. Envía tu idea, fecha y número de porciones para recibir una cotización.'
    : 'Elizabeth creates custom cakes for birthdays, weddings, quinceañeras, and family events. Send your idea, date, and serving count to request a quote.';

const pageTitle = title ?? defaultTitle;
const pageDescription = description ?? defaultDescription;

const homeHref = lang === 'es' ? '/es/' : '/en/';
const galleryHref = lang === 'es' ? '/es/galeria/' : '/en/gallery/';
const quoteHref = lang === 'es' ? '/es/contacto/' : '/en/contact/';

const galleryLabel = lang === 'es' ? 'Galería' : 'Gallery';
const quoteLabel = lang === 'es' ? 'Solicitar cotización' : 'Request quote';
const footerTagline =
  lang === 'es' ? 'Pasteles por encargo · Recogida con cita previa' : 'Made-to-order cakes · Pickup by appointment';
const rights = lang === 'es' ? 'Todos los derechos reservados.' : 'All rights reserved.';

// Locale alternates (translate the localized slug between es/en) for hreflang + OG.
const slugMap: Record<'es' | 'en', Record<string, string>> = {
  es: { galeria: 'gallery', contacto: 'contact' },
  en: { gallery: 'galeria', contact: 'contacto' }
};
const otherLang = lang === 'es' ? 'en' : 'es';
const stripped = Astro.url.pathname.replace(/^\/(es|en)/, '').replace(/^\/+|\/+$/g, '');
const segs = stripped ? stripped.split('/') : [];
if (segs.length > 0) segs[0] = slugMap[lang][segs[0]] ?? segs[0];
const otherPath = segs.length > 0 ? `/${otherLang}/${segs.join('/')}/` : `/${otherLang}/`;
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).toString() : p);
const esUrl = abs(lang === 'es' ? Astro.url.pathname : otherPath);
const enUrl = abs(lang === 'en' ? Astro.url.pathname : otherPath);
const ogImage = abs('/og-image.jpg');
const ogLocale = lang === 'es' ? 'es_ES' : 'en_US';
const ogLocaleAlt = lang === 'es' ? 'en_US' : 'es_ES';
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: brand,
  description: defaultDescription,
  url: Astro.site ? Astro.site.toString() : undefined,
  logo: abs('/favicon.svg'),
  image: ogImage,
  inLanguage: ['es', 'en']
};
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#FFF7E0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {!noindex && <link rel="alternate" hreflang="es" href={esUrl} />}
    {!noindex && <link rel="alternate" hreflang="en" href={enUrl} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={esUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {!noindex && canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={brand} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Nunito:ital,wght@0,400;0,600;0,700;0,800;1,400;1,700&display=swap"
    />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="sticky top-0 z-40 border-b-2 border-ink bg-cream/95 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:px-6">
        <a href={homeHref} class="group inline-flex min-w-0 items-center gap-2 font-display text-sm font-extrabold leading-tight text-ink sm:text-xl">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border-2 border-ink bg-sun text-base shadow-sticker-sm transition-transform group-hover:-rotate-6" aria-hidden="true">🎂</span>
          <span>{brand}</span>
        </a>
        <nav class="flex shrink-0 items-center gap-2 sm:gap-3">
          <a href={galleryHref} class="hidden rounded-full border-2 border-ink bg-paper px-4 py-2 text-sm font-bold text-ink shadow-sticker-sm transition-transform hover:-translate-y-0.5 sm:inline-flex">
            {galleryLabel}
          </a>
          <a href={quoteHref} class="lg-btn shrink-0 bg-coral px-4 py-2 text-sm text-ink sm:px-5">
            <span class="sm:hidden">{lang === 'es' ? 'Cotización' : 'Quote'}</span>
            <span class="hidden sm:inline">{quoteLabel}</span>
          </a>
          <LanguageSwitcher currentLocale={lang} />
        </nav>
      </div>
    </header>
    <main class="flex-1">
      <slot />
    </main>
    <footer class="mt-4 border-t-2 border-ink bg-cream-deep/60">
      <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-8 text-sm sm:px-6">
        <p class="inline-flex items-center gap-2 font-display text-base font-extrabold text-ink">
          <span aria-hidden="true">🎂</span> {brand}
        </p>
        <p class="font-semibold text-ink-soft">{footerTagline}</p>
        <p class="text-ink-muted">&copy; {new Date().getFullYear()} {brand}. {rights}</p>
      </div>
    </footer>
  </body>
</html>
