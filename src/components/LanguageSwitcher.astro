---
interface Props {
  currentLocale: 'es' | 'en';
  pathname?: string;
}

const { currentLocale, pathname = Astro.url.pathname } = Astro.props as Props;

const nextLocale = currentLocale === 'es' ? 'en' : 'es';
const label = currentLocale === 'es' ? 'English' : 'Español';

// Routes use locale-specific slugs, so the first path segment must be
// translated when switching locale (otherwise /es/galeria/ -> /en/galeria/ 404s).
const slugTranslations: Record<'es' | 'en', Record<string, string>> = {
  es: { galeria: 'gallery', contacto: 'contact' },
  en: { gallery: 'galeria', contact: 'contacto' }
};

const stripped = pathname.replace(/^\/(es|en)/, '').replace(/^\/+|\/+$/g, '');
const segments = stripped ? stripped.split('/') : [];
if (segments.length > 0) {
  segments[0] = slugTranslations[currentLocale][segments[0]] ?? segments[0];
}
const targetPath = segments.length > 0 ? `/${segments.join('/')}/` : '/';
const href = `/${nextLocale}${targetPath}`;
---
<a
  href={href}
  class="inline-flex items-center gap-2 rounded-full border border-gray-300 bg-white px-3 py-1 text-xs font-semibold uppercase tracking-wide text-gray-600 transition hover:border-brand-400 hover:text-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:ring-offset-2"
>
  <span aria-hidden="true">🌐</span>
  <span>{label}</span>
</a>
