---
import ResponsiveImage from './ResponsiveImage.astro';

export interface Props {
  cakes: any[];
  lang: 'es' | 'en';
}

const { cakes, lang } = Astro.props;

// Get featured cakes for hero display
const featuredCakes = cakes.filter(cake => cake.data.featured).slice(0, 3);
const allCakes = cakes.slice(0, 6); // Show up to 6 cakes in hero

const texts = {
  es: {
    title: "Pasteles Artesanales Hechos con Amor",
    subtitle: "Creaciones únicas para tus momentos más especiales",
    orderButton: "Solicitar Pastel Personalizado",
    viewGallery: "Ver Galería Completa",
    occasions: {
      wedding: "Bodas",
      birthday: "Cumpleaños", 
      celebration: "Celebraciones",
      custom: "Personalizado"
    }
  },
  en: {
    title: "Artisan Cakes Made with Love",
    subtitle: "Unique creations for your most special moments",
    orderButton: "Order Custom Cake",
    viewGallery: "View Full Gallery",
    occasions: {
      wedding: "Weddings",
      birthday: "Birthdays",
      celebration: "Celebrations", 
      custom: "Custom"
    }
  }
};

const t = texts[lang];
---

<!-- Hero Section - Cake Gallery as Primary Focus -->
<section class="relative overflow-hidden bg-gradient-to-br from-cream via-warm-cream to-soft-pink/20">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width="60" height="60" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg"%3E%3Cg fill="none" fill-rule="evenodd"%3E%3Cg fill="%23D4A574" fill-opacity="0.1"%3E%3Ccircle cx="30" cy="30" r="2"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')]"></div>
  </div>

  <div class="relative px-6 py-16 md:px-12 md:py-24">
    <div class="mx-auto max-w-7xl">
      
      <!-- Hero Header - Mobile Optimized -->
      <div class="text-center mb-12 sm:mb-16">
        <h1 class="text-3xl sm:text-4xl font-serif font-bold text-warm-brown md:text-6xl lg:text-7xl mb-4 sm:mb-6 leading-tight px-4 sm:px-0">
          {t.title}
        </h1>
        <p class="text-lg sm:text-xl text-gray-600 md:text-2xl mb-6 sm:mb-8 max-w-3xl mx-auto px-4 sm:px-0 leading-relaxed">
          {t.subtitle}
        </p>
        
        <!-- Primary CTA - Mobile Optimized -->
        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center items-center px-4 sm:px-0">
          <a
            href={lang === 'es' ? '#pedido-personalizado' : '#custom-order'}
            class="w-full sm:w-auto inline-flex items-center justify-center rounded-full bg-warm-brown px-6 sm:px-8 py-3 sm:py-4 text-sm sm:text-base font-semibold uppercase tracking-wide text-white shadow-xl transition-all duration-300 hover:-translate-y-1 hover:bg-warm-brown/90 hover:shadow-2xl active:scale-95 touch-manipulation"
          >
            <span class="mr-2">🎂</span>
            {t.orderButton}
          </a>
          <a
            href={lang === 'es' ? '#galeria-completa' : '#full-gallery'}
            class="w-full sm:w-auto inline-flex items-center justify-center rounded-full border-2 border-warm-brown px-6 sm:px-8 py-3 sm:py-4 text-sm sm:text-base font-semibold uppercase tracking-wide text-warm-brown transition-all duration-300 hover:bg-warm-brown hover:text-white active:scale-95 touch-manipulation"
          >
            {t.viewGallery}
          </a>
        </div>
      </div>

      <!-- Featured Cakes Grid - Mobile Optimized -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 mb-12" role="region" aria-labelledby="cake-gallery-title">
        <h2 id="cake-gallery-title" class="sr-only">
          {lang === 'es' ? 'Galería de pasteles destacados' : 'Featured cake gallery'}
        </h2>
        {allCakes.map((cake, index) => {
          const orderAnchor = lang === 'es' ? '#pedido-personalizado' : '#custom-order';
          const loading = index < 2 ? 'eager' : 'lazy';

          return (
          <article class="group relative overflow-hidden rounded-2xl bg-white shadow-xl transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl touch-manipulation" role="article" aria-labelledby={`cake-title-${index}`}>
            <!-- Cake Image - Mobile Optimized -->
            <div class="aspect-square overflow-hidden relative">
              {cake.data.images && cake.data.images[0] && (
                <ResponsiveImage
                  src={cake.data.images[0].src}
                  alt={cake.data.images[0].alt}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110 group-active:scale-105"
                  loading={loading}
                  decoding="async"
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                  width={400}
                  height={400}
                />
              )}
              <!-- Mobile-Optimized Badges -->
              <div class="absolute top-3 left-3 sm:top-4 sm:left-4">
                <span class="inline-flex items-center rounded-full bg-white/95 px-2 py-1 sm:px-3 sm:py-1 text-xs sm:text-sm font-medium text-warm-brown shadow-lg backdrop-blur-sm">
                  {t.occasions[cake.data.occasion as keyof typeof t.occasions]}
                </span>
              </div>

              <!-- Featured Badge - Mobile Optimized -->
              {cake.data.featured && (
                <div class="absolute top-3 right-3 sm:top-4 sm:right-4">
                  <span class="inline-flex items-center rounded-full bg-gold-accent/95 px-2 py-1 sm:px-3 sm:py-1 text-xs sm:text-sm font-medium text-white shadow-lg backdrop-blur-sm">
                    <span class="hidden sm:inline">⭐ </span>{lang === 'es' ? 'Destacado' : 'Featured'}
                  </span>
                </div>
              )}

              <!-- Mobile Touch Overlay -->
              <div class="absolute inset-0 bg-black/0 group-active:bg-black/5 transition-colors duration-150 sm:hidden"></div>
            </div>

            <!-- Cake Details - Mobile Optimized -->
            <div class="p-4 sm:p-6">
              <h3 id={`cake-title-${index}`} class="text-lg sm:text-xl font-serif font-bold text-warm-brown mb-2 leading-tight">
                {cake.data.title}
              </h3>
              <p class="text-gray-600 mb-4 line-clamp-2 text-sm sm:text-base leading-relaxed">
                {cake.data.description}
              </p>
              {cake.data.designElements && cake.data.designElements.length > 0 && (
                <div class="flex flex-wrap gap-1.5 sm:gap-2 mb-4">
                  {cake.data.designElements.slice(0, 2).map((element: string) => (
                    <span class="inline-flex items-center rounded-full bg-soft-pink/20 px-2 py-1 text-xs font-medium text-warm-brown">
                      {element}
                    </span>
                  ))}
                  {cake.data.designElements.length > 2 && (
                    <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-1 text-xs font-medium text-gray-600">
                      +{cake.data.designElements.length - 2} {lang === 'es' ? 'más' : 'more'}
                    </span>
                  )}
                </div>
              )}

              <a
                href={orderAnchor}
                class="w-full inline-flex items-center justify-center rounded-full bg-gradient-to-r from-warm-brown to-gold-accent px-4 sm:px-6 py-3 text-sm font-semibold text-white transition-all duration-300 hover:from-gold-accent hover:to-warm-brown hover:shadow-lg active:scale-95 touch-manipulation"
                aria-label={`${lang === 'es' ? 'Solicitar pastel similar a' : 'Order cake similar to'} ${cake.data.title}`}
              >
                {lang === 'es' ? 'Solicitar Similar' : 'Order Similar'}
              </a>
            </div>
          </article>
        );
        })}
      </div>

      <!-- Process Preview - Mobile Optimized -->
      <div class="text-center px-4 sm:px-0">
        <h2 class="text-xl sm:text-2xl font-serif font-bold text-warm-brown md:text-3xl mb-6 sm:mb-8">
          {lang === 'es' ? 'Nuestro Proceso Artesanal' : 'Our Artisan Process'}
        </h2>
        <p class="max-w-3xl mx-auto text-gray-600">
          {lang === 'es'
            ? 'Desde el diseño inicial hasta la decoración final, cada pastel se elabora cuidadosamente en nuestro taller de Genoa, Illinois.'
            : 'From the initial design to the final decoration, every cake is crafted carefully in our Genoa, Illinois studio.'}
        </p>
      </div>

    </div>
  </div>
</section>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Image optimization */
  img {
    /* Improve image rendering quality */
    image-rendering: -webkit-optimize-contrast;
    image-rendering: optimize-contrast;
    
    /* Prevent layout shift during loading */
    content-visibility: auto;
    contain-intrinsic-size: 400px 400px;
  }

  /* Mobile-specific optimizations */
  @media (max-width: 640px) {
    .cake-card {
      /* Improve touch targets */
      min-height: 44px;
    }
    
    /* Improve text readability on mobile */
    .mobile-text {
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    
    /* Optimize images for mobile */
    img {
      image-rendering: auto;
    }
  }

  /* Touch-friendly interactions */
  .touch-manipulation {
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  /* Smooth scrolling for mobile navigation */
  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }

  /* Screen reader only content */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Focus indicators for accessibility */
  button:focus-visible,
  a:focus-visible,
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 2px solid #8B4513;
    outline-offset: 2px;
  }

  /* High contrast mode support */
  @media (prefers-contrast: high) {
    .cake-card {
      border: 2px solid;
    }
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
