---
export interface Props {
  src: string;
  alt: string;
  width?: number | string;
  height?: number | string;
  class?: string;
  loading?: 'lazy' | 'eager';
  decoding?: 'auto' | 'sync' | 'async';
  sizes?: string;
}

const {
  src,
  alt,
  width,
  height,
  class: className = '',
  loading = 'lazy',
  decoding = 'async',
  sizes,
} = Astro.props;
---

<img
  src={src}
  alt={alt}
  class={className}
  loading={loading}
  decoding={decoding}
  width={width}
  height={height}
  sizes={sizes}
/>
