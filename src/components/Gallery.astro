---
import ResponsiveImage from './ResponsiveImage.astro';

export interface Props {
  images: Array<{
    src: string;
    alt: string;
    caption?: string;
    category?: string;
  }>;
  title: string;
}

const { images, title } = Astro.props;

const accentGradients = [
  'from-soft-pink to-warm-cream',
  'from-cream to-soft-pink',
  'from-warm-cream to-white',
];

const cards = images.map((image, index) => ({
  image,
  accent: accentGradients[index % accentGradients.length],
}));
---

<section id="galeria" class="py-20 px-6 md:px-12">
  <div class="mx-auto max-w-4xl text-center">
    <p class="text-xs font-semibold uppercase tracking-widest text-gold-accent">
      Galería
    </p>
    <h2 class="mt-3 text-4xl font-serif font-bold text-warm-brown md:text-5xl">
      {title}
    </h2>
    <p class="mt-4 text-base text-gray-600">
      Creaciones artesanales listas para inspirar tu próximo evento especial.
    </p>
  </div>

  <div class="mx-auto mt-12 grid max-w-5xl gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {cards.map(({ image, accent }, index) => {
      const eager = index < 2;
      return (
        <article class="group flex flex-col rounded-3xl border border-white/60 bg-white/85 shadow-lg backdrop-blur-sm transition-shadow duration-300 hover:shadow-2xl focus-within:shadow-2xl focus-within:outline-none">
          <div class={`relative overflow-hidden rounded-2xl bg-gradient-to-br ${accent}`}>
            <ResponsiveImage
              src={image.src}
              alt={image.alt}
              loading={eager ? 'eager' : 'lazy'}
              decoding="async"
              width={1600}
              height={1066}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
            />
          </div>

          <div class="mt-5 space-y-2 px-6 pb-6">
            <h3 class="text-lg font-serif font-semibold text-warm-brown">
              {image.alt}
            </h3>
            {image.caption && (
              <p class="text-sm text-gray-600">
                {image.caption}
              </p>
            )}
            {image.category && (
              <span class="inline-flex items-center rounded-full bg-cream px-3 py-1 text-xs font-medium uppercase tracking-wide text-gold-accent">
                {image.category}
              </span>
            )}
          </div>
        </article>
      );
    })}
  </div>

  <p class="mt-10 text-center text-sm text-gray-500">
    📸 Las imágenes finales se publican al lanzar la galería oficial. Mientras tanto, disfruta estas descripciones como inspiración.
  </p>
</section>
