---
export interface Props {
  businessData: any;
  lang: 'es' | 'en';
}

const { businessData, lang } = Astro.props;
const business = businessData.data;

const texts = {
  es: {
    title: "Información del Negocio Local",
    subtitle: "Tu repostería de confianza en el corazón de la ciudad",
    hoursTitle: "Horarios de Atención",
    contactTitle: "Contáctanos",
    serviceAreaTitle: "Área de Servicio",
    leadTimesTitle: "Tiempos de Entrega",
    policiesTitle: "Políticas de Pedidos",
    phone: "Teléfono",
    email: "Correo",
    whatsapp: "WhatsApp",
    address: "Dirección",
    days: {
      lunes: "Lunes",
      martes: "Martes", 
      miercoles: "Miércoles",
      jueves: "Jueves",
      viernes: "Viernes",
      sabado: "Sábado",
      domingo: "Domingo"
    },
    leadTimeLabels: {
      standard: "Pedidos Estándar",
      wedding: "Pasteles de Boda",
      rush: "Pedidos Express"
    },
    contactButton: "Contactar Ahora",
    whatsappButton: "WhatsApp"
  },
  en: {
    title: "Local Business Information", 
    subtitle: "Your trusted bakery in the heart of the city",
    hoursTitle: "Business Hours",
    contactTitle: "Contact Us",
    serviceAreaTitle: "Service Area",
    leadTimesTitle: "Lead Times",
    policiesTitle: "Order Policies",
    phone: "Phone",
    email: "Email",
    whatsapp: "WhatsApp",
    address: "Address",
    days: {
      monday: "Monday",
      tuesday: "Tuesday",
      wednesday: "Wednesday", 
      thursday: "Thursday",
      friday: "Friday",
      saturday: "Saturday",
      sunday: "Sunday"
    },
    leadTimeLabels: {
      standard: "Standard Orders",
      wedding: "Wedding Cakes",
      rush: "Express Orders"
    },
    contactButton: "Contact Now",
    whatsappButton: "WhatsApp"
  }
};

const t = texts[lang];
---

<!-- Local Business Information Section -->
<section class="px-6 py-20 bg-white md:px-12" id="business-info" role="region" aria-labelledby="business-info-title">
  <div class="mx-auto max-w-6xl">
    
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 id="business-info-title" class="text-3xl font-serif font-bold text-warm-brown md:text-4xl mb-4">
        {t.title}
      </h2>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        {t.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      
      <!-- Left Column: Contact & Hours -->
      <div class="space-y-8">
        
        <!-- Contact Information -->
        <div class="bg-gradient-to-br from-cream to-warm-cream/50 rounded-2xl p-8 shadow-lg">
          <h3 class="text-2xl font-serif font-bold text-warm-brown mb-6 flex items-center">
            <span class="mr-3">📞</span>
            {t.contactTitle}
          </h3>
          
          <div class="space-y-4">
            <!-- Phone -->
            <div class="flex items-center">
              <div class="w-12 h-12 bg-warm-brown rounded-full flex items-center justify-center mr-4">
                <span class="text-white text-lg">📱</span>
              </div>
              <div>
                <p class="font-semibold text-warm-brown">{t.phone}</p>
                <a href={`tel:${business.contact.phone}`} class="text-gray-600 hover:text-warm-brown transition-colors">
                  {business.contact.phone}
                </a>
              </div>
            </div>

            <!-- Email -->
            <div class="flex items-center">
              <div class="w-12 h-12 bg-warm-brown rounded-full flex items-center justify-center mr-4">
                <span class="text-white text-lg">✉️</span>
              </div>
              <div>
                <p class="font-semibold text-warm-brown">{t.email}</p>
                <a href={`mailto:${business.contact.email}`} class="text-gray-600 hover:text-warm-brown transition-colors">
                  {business.contact.email}
                </a>
              </div>
            </div>

            <!-- WhatsApp -->
            <div class="flex items-center">
              <div class="w-12 h-12 bg-emerald-800 rounded-full flex items-center justify-center mr-4">
                <span class="text-white text-lg">💬</span>
              </div>
              <div>
                <p class="font-semibold text-warm-brown">{t.whatsapp}</p>
                <a 
                  href={`https://wa.me/${business.contact.whatsapp.replace(/[^0-9]/g, '')}?text=${lang === 'es' ? 'Hola, me interesa solicitar un pastel personalizado' : 'Hello, I am interested in ordering a custom cake'}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-gray-600 hover:text-emerald-800 transition-colors"
                >
                  {business.contact.whatsapp}
                </a>
              </div>
            </div>

            <!-- Address -->
            <div class="flex items-center">
              <div class="w-12 h-12 bg-warm-brown rounded-full flex items-center justify-center mr-4">
                <span class="text-white text-lg">📍</span>
              </div>
              <div>
                <p class="font-semibold text-warm-brown">{t.address}</p>
                <p class="text-gray-600">{business.address}</p>
              </div>
            </div>
          </div>

          <!-- Contact Buttons -->
          <div class="flex flex-col sm:flex-row gap-4 mt-8">
            <a
              href={`tel:${business.contact.phone}`}
              class="flex-1 inline-flex items-center justify-center rounded-full bg-warm-brown px-6 py-3 text-sm font-semibold text-white transition-all duration-300 hover:bg-warm-brown/90 hover:shadow-lg"
            >
              <span class="mr-2">📞</span>
              {t.contactButton}
            </a>
            <a
              href={`https://wa.me/${business.contact.whatsapp.replace(/[^0-9]/g, '')}?text=${lang === 'es' ? 'Hola, me interesa solicitar un pastel personalizado' : 'Hello, I am interested in ordering a custom cake'}`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 inline-flex items-center justify-center rounded-full bg-emerald-800 px-6 py-3 text-sm font-semibold text-white transition-all duration-300 hover:bg-emerald-900 hover:shadow-lg focus:outline-none focus:ring-4 focus:ring-emerald-600"
            >
              <span class="mr-2">💬</span>
              {t.whatsappButton}
            </a>
          </div>
        </div>

        <!-- Business Hours -->
        <div class="bg-gradient-to-br from-soft-pink/20 to-cream/50 rounded-2xl p-8 shadow-lg">
          <h3 class="text-2xl font-serif font-bold text-warm-brown mb-6 flex items-center">
            <span class="mr-3">🕒</span>
            {t.hoursTitle}
          </h3>
          
          <div class="space-y-3">
            {Object.entries(business.hours).map(([day, hours]) => (
              <div class="flex justify-between items-center py-2 border-b border-warm-brown/10 last:border-b-0">
                <span class="font-medium text-warm-brown capitalize">
                  {lang === 'es' ? t.days[day as keyof typeof t.days] || day : t.days[day as keyof typeof t.days] || day}
                </span>
                <span class="text-gray-600 font-medium">
                  {hours}
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Right Column: Service Area & Lead Times -->
      <div class="space-y-8">
        
        <!-- Service Area -->
        <div class="bg-gradient-to-br from-warm-cream/50 to-gold-accent/10 rounded-2xl p-8 shadow-lg">
          <h3 class="text-2xl font-serif font-bold text-warm-brown mb-6 flex items-center">
            <span class="mr-3">🗺️</span>
            {t.serviceAreaTitle}
          </h3>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {business.serviceArea.map((area: string) => (
              <div class="flex items-center p-3 bg-white rounded-lg shadow-sm">
                <span class="w-3 h-3 bg-emerald-800 rounded-full mr-3"></span>
                <span class="text-gray-700 font-medium">{area}</span>
              </div>
            ))}
          </div>
          
          <p class="text-sm text-gray-600 mt-4 italic">
            {lang === 'es' 
              ? 'Consulta costos de entrega según la zona. Recogida disponible sin costo adicional.'
              : 'Check delivery costs by area. Pickup available at no additional cost.'
            }
          </p>
        </div>

        <!-- Lead Times -->
        <div class="bg-gradient-to-br from-gold-accent/10 to-warm-cream/50 rounded-2xl p-8 shadow-lg">
          <h3 class="text-2xl font-serif font-bold text-warm-brown mb-6 flex items-center">
            <span class="mr-3">⏰</span>
            {t.leadTimesTitle}
          </h3>
          
          <div class="space-y-4">
            {Object.entries(business.leadTimes).map(([type, time]) => (
              <div class="flex items-center justify-between p-4 bg-white rounded-lg shadow-sm">
                <div class="flex items-center">
                  <div class="w-10 h-10 bg-warm-brown rounded-full flex items-center justify-center mr-4">
                    <span class="text-white text-sm">
                      {type === 'standard' ? '📅' : type === 'wedding' ? '💒' : '⚡'}
                    </span>
                  </div>
                  <span class="font-medium text-warm-brown">
                    {t.leadTimeLabels[type as keyof typeof t.leadTimeLabels]}
                  </span>
                </div>
                <span class="text-gray-600 font-medium text-sm">
                  {time}
                </span>
              </div>
            ))}
          </div>
        </div>

        <!-- Policies (if available) -->
        {business.policies && (
          <div class="bg-gradient-to-br from-cream to-soft-pink/20 rounded-2xl p-8 shadow-lg">
            <h3 class="text-2xl font-serif font-bold text-warm-brown mb-6 flex items-center">
              <span class="mr-3">📋</span>
              {t.policiesTitle}
            </h3>
            
            <div class="space-y-3 text-sm text-gray-600">
              {business.policies.minimumNotice && (
                <p class="flex items-start">
                  <span class="text-warm-brown mr-2">•</span>
                  {business.policies.minimumNotice}
                </p>
              )}
              {business.policies.depositRequired && (
                <p class="flex items-start">
                  <span class="text-warm-brown mr-2">•</span>
                  {business.policies.depositRequired}
                </p>
              )}
              {business.policies.cancellationPolicy && (
                <p class="flex items-start">
                  <span class="text-warm-brown mr-2">•</span>
                  {business.policies.cancellationPolicy}
                </p>
              )}
              {business.policies.allergyDisclaimer && (
                <p class="flex items-start">
                  <span class="text-warm-brown mr-2">•</span>
                  {business.policies.allergyDisclaimer}
                </p>
              )}
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</section>