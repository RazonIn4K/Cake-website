---
interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props as Props;

// WhatsApp number in international format, digits only (no "+", spaces, or dashes).
// Source: +1 (815) 501-2963. If this is ever cleared, the form gracefully falls
// back to showing a copyable summary instead of linking anywhere.
const WHATSAPP_NUMBER = '18155012963';

// ============================================================================
// TODO (David): paste the Web3Forms access key so EVERY quote request is emailed
// to Elizabeth — works with or without WhatsApp, nothing is lost. Get a free key
// in ~1 min at https://web3forms.com (enter Elizabeth's email; it emails you a
// key). The key is public and safe to commit. While this stays EMPTY, the form
// falls back to the WhatsApp-only flow.
// ============================================================================
const WEB3FORMS_ACCESS_KEY = '6914ab39-47b6-4cf5-8170-61fe681585d5';

const copy = {
