  }
} as const;

const t = copy[lang];

const fieldClass = 'lg-input mt-1.5';
const labelClass = 'block font-display text-sm font-bold text-ink';
---
<form id="quote-form" novalidate class="lg-card p-6 sm:p-8">
  <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <fieldset class="space-y-5">
    <legend class="font-display text-xl font-extrabold text-ink">{t.detailsLegend}</legend>

    <div>
      <label class={labelClass} for="qf-name">
        {t.name} <span class="text-brand-600" aria-hidden="true">*</span>
      </label>
      <input id="qf-name" name="name" type="text" required autocomplete="name" placeholder={t.namePlaceholder} class={fieldClass} />
    </div>

    <div>
      <label class={labelClass} for="qf-event-type">
        {t.eventType} <span class="text-brand-600" aria-hidden="true">*</span>
      </label>
      <select id="qf-event-type" name="event-type" required class={fieldClass}>
        <option value="" selected disabled>{t.eventTypePlaceholder}</option>
        {t.eventTypes.map((option) => (
          <option value={option}>{option}</option>
        ))}
      </select>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label class={labelClass} for="qf-date">
          {t.date} <span class="text-brand-600" aria-hidden="true">*</span>
        </label>
        <input id="qf-date" name="date" type="date" required class={fieldClass} />
      </div>
      <div>
        <label class={labelClass} for="qf-servings">
          {t.servings} <span class="text-brand-600" aria-hidden="true">*</span>
        </label>
        <input id="qf-servings" name="servings" type="number" min="1" inputmode="numeric" required placeholder={t.servingsPlaceholder} class={fieldClass} />
      </div>
    </div>

    <div>
      <label class={labelClass} for="qf-details">{t.details}</label>
      <textarea id="qf-details" name="details" rows="4" placeholder={t.detailsPlaceholder} class={fieldClass}></textarea>
    </div>

    <div>
      <label class={labelClass} for="qf-email">
        {t.email} <span class="font-normal text-ink-muted">({t.emailOptional})</span>
      </label>
      <input id="qf-email" name="email" type="email" autocomplete="email" class={fieldClass} aria-describedby="qf-email-hint" />
      <p id="qf-email-hint" class="mt-1.5 text-xs font-medium text-ink-muted">{t.emailHint}</p>
    </div>
  </fieldset>

  <fieldset class="mt-6 space-y-3 border-t-2 border-dashed border-ink/25 pt-6">
    <legend class="font-display text-xl font-extrabold text-ink">{t.fulfillmentLegend}</legend>
    <p class="text-sm font-medium text-ink-soft">{t.pickupNote}</p>

    <div>
      <input id="qf-wants-delivery" name="wants-delivery" type="checkbox" class="peer h-5 w-5 rounded border-2 border-ink align-middle accent-coral" />
      <label for="qf-wants-delivery" class="ml-2 align-middle text-sm font-semibold text-ink">{t.deliveryToggle}</label>
      <div class="mt-3 hidden rounded-2xl border-2 border-ink bg-sky-soft p-4 peer-checked:block">
        <p class="text-sm font-medium text-ink-soft">{t.deliveryNote}</p>
        <div class="mt-3">
          <label class={labelClass} for="qf-delivery-zone">{t.deliveryZone}</label>
          <input id="qf-delivery-zone" name="delivery-zone" type="text" placeholder={t.deliveryZonePlaceholder} class={fieldClass} aria-describedby="qf-zone-hint" />
          <p id="qf-zone-hint" class="mt-1.5 text-xs font-medium text-ink-muted">{t.deliveryZoneHint}</p>
        </div>
      </div>
    </div>
  </fieldset>

  <p class="mt-6 text-sm font-medium text-ink-soft">{t.photosNote}</p>

  <button
    type="submit"
    class="lg-btn mt-6 w-full bg-coral px-7 py-3.5 text-base text-ink sm:w-auto"
  >
    {t.submit}
  </button>

  <noscript>
    <p class="mt-4 text-sm text-amber-700">{t.noscript}</p>
  </noscript>
</form>

<p id="qf-status" role="status" aria-live="polite" class="sr-only"></p>

<div id="quote-result" role="region" aria-labelledby="quote-result-title" class="lg-card mt-6 hidden bg-lime-soft p-6">
  <h3 id="quote-result-title" tabindex="-1" class="font-display text-xl font-extrabold text-ink focus:outline-none">{t.successTitle}</h3>
  <p id="quote-result-body" class="mt-2 text-sm font-medium text-ink-soft">{t.successBody}</p>
  <div id="quote-summary-wrap" hidden>
    <textarea id="quote-summary" readonly rows="10" class="mt-4 block w-full rounded-2xl border-2 border-ink bg-paper px-3 py-2 font-mono text-xs text-ink focus:outline-none"></textarea>
    <button
      type="button"
      id="copy-summary"
      class="lg-btn mt-3 bg-sun px-5 py-2.5 text-sm text-ink"
    >
      {t.copyButton}
    </button>
  </div>
  <a id="quote-result-whatsapp" href="#" target="_blank" rel="noopener" hidden class="lg-btn mt-4 bg-coral px-5 py-2.5 text-sm text-ink">
    {t.whatsappCta}
  </a>
</div>

<script define:vars={{ WHATSAPP_NUMBER, WEB3FORMS_ACCESS_KEY, t }}>
  const form = document.getElementById('quote-form');
  const result = document.getElementById('quote-result');
  const summaryEl = document.getElementById('quote-summary');
  const summaryWrap = document.getElementById('quote-summary-wrap');
  const copyBtn = document.getElementById('copy-summary');
  const titleEl = document.getElementById('quote-result-title');
  const bodyEl = document.getElementById('quote-result-body');
  const waBtn = document.getElementById('quote-result-whatsapp');
  const statusEl = document.getElementById('qf-status');
  const submitBtn = form ? form.querySelector('button[type="submit"]') : null;

  let waUrl = null;
  let lastMessage = '';

  function buildMessage(data) {
    const lines = [t.msgIntro, ''];
    lines.push(`${t.msgName}: ${data.name}`);
    lines.push(`${t.msgEvent}: ${data.eventType}`);
    lines.push(`${t.msgDate}: ${data.date}`);
    lines.push(`${t.msgServings}: ${data.servings}`);
    if (data.wantsDelivery) {
      lines.push(`${t.msgFulfillment}: ${t.msgDelivery}`);
      if (data.zone) lines.push(`${t.msgZone}: ${data.zone}`);
    } else {
      lines.push(`${t.msgFulfillment}: ${t.msgPickup}`);
    }
    if (data.details) lines.push(`${t.msgDetails}: ${data.details}`);
    if (data.email) lines.push(`${t.msgEmail}: ${data.email}`);
    return lines.join('\n');
  }

  function getData() {
    const fd = new FormData(form);
    const value = (key) => (fd.get(key) || '').toString().trim();
    return {
      name: value('name'),
      eventType: value('event-type'),
      date: value('date'),
      servings: value('servings'),
      details: value('details'),
      email: value('email'),
      wantsDelivery: fd.get('wants-delivery') === 'on',
      zone: value('delivery-zone'),
      botcheck: (fd.get('botcheck') || '').toString()
    };
  }

  // kind: 'success' | 'error' | 'fallback'
  function showResult(kind) {
    if (!result) return;
    let title, body, showSummary, isError;
    if (kind === 'success') { title = t.successTitle; body = t.successBody; showSummary = false; isError = false; }
    else if (kind === 'error') { title = t.errorTitle; body = t.errorBody; showSummary = true; isError = true; }
    else { title = t.fallbackTitle; body = t.fallbackBody; showSummary = true; isError = false; }

    if (titleEl) titleEl.textContent = title;
    if (bodyEl) bodyEl.textContent = body;
    if (summaryWrap) {
      if (showSummary && summaryEl) { summaryEl.value = lastMessage; summaryWrap.hidden = false; }
      else summaryWrap.hidden = true;
    }
    if (waBtn) {
      if (waUrl) { waBtn.href = waUrl; waBtn.hidden = false; } else { waBtn.hidden = true; }
    }
    result.classList.toggle('bg-pink-soft', isError);
    result.classList.toggle('bg-lime-soft', !isError);
    result.classList.remove('hidden');
    if (statusEl) statusEl.textContent = title;
    if (titleEl) titleEl.focus();
    result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  async function sendToBackend(data) {
    const payload = {
      access_key: WEB3FORMS_ACCESS_KEY,
      subject: `${t.emailSubject} — ${data.name}`,
      from_name: data.name,
      name: data.name,
      event_type: data.eventType,
      date: data.date,
      servings: data.servings,
      fulfillment: data.wantsDelivery ? t.msgDelivery : t.msgPickup,
      delivery_zone: data.zone,
      details: data.details,
      email: data.email,
      message: lastMessage,
      botcheck: data.botcheck
    };
    if (data.email) payload.replyto = data.email;
    const res = await fetch('https://api.web3forms.com/submit', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify(payload)
    });
    const json = await res.json().catch(() => ({}));
    return res.ok && json && json.success === true;
  }

  if (form) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const data = getData();
      if (data.botcheck) return; // honeypot tripped
      lastMessage = buildMessage(data);
      waUrl = WHATSAPP_NUMBER ? `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(lastMessage)}` : null;

      if (WEB3FORMS_ACCESS_KEY) {
        const originalLabel = submitBtn ? submitBtn.textContent : '';
        if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = t.sending; }
        if (statusEl) statusEl.textContent = t.sending;
        let ok = false;
        try { ok = await sendToBackend(data); } catch (_) { ok = false; }
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = originalLabel; }
        showResult(ok ? 'success' : 'error');
        return;
      }

      // No backend configured yet — WhatsApp-first flow.
      if (waUrl) {
        const win = window.open(waUrl, '_blank', 'noopener');
        if (win) return;
      }
      showResult('fallback');
    });
  }

  if (copyBtn && summaryEl) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(summaryEl.value);
      } catch (_) {
        summaryEl.focus();
        summaryEl.select();
      }
      const original = t.copyButton;
      copyBtn.textContent = t.copiedButton;
      if (statusEl) statusEl.textContent = t.copiedButton;
      setTimeout(() => {
        copyBtn.textContent = original;
      }, 2000);
    });
  }
</script>
