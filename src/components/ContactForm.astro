---
export interface Props {
  title: string;
  lang: 'es' | 'en';
}

const { title, lang } = Astro.props;

const labels = {
  es: {
    heading: 'Agenda tu pastel',
    intro: 'Comparte los detalles de tu celebración y diseñamos un pastel único para ti.',
    name: 'Nombre',
    email: 'Email',
    eventDate: 'Fecha del Evento',
    description: 'Descripción del Pastel',
    budget: 'Presupuesto Aproximado',
    submit: 'Solicitar Cotización',
    placeholder: 'Cuéntame sobre tu pastel ideal...',
    whatsapp: 'Contactar por WhatsApp',
    whatsappLead: '💬 También puedes contactarme directamente por WhatsApp',
    subject: 'Nueva cotización de pastel (ES)',
    budgetOptions: [
      { value: '', text: 'Selecciona un rango' },
      { value: '50-100', text: '$50 - $100 USD' },
      { value: '100-200', text: '$100 - $200 USD' },
      { value: '200-300', text: '$200 - $300 USD' },
      { value: '300+', text: '$300+ USD' }
    ],
    whatsappMessage: 'Hola, me interesa cotizar un pastel personalizado'
  },
  en: {
    heading: 'Plan Your Cake',
    intro: 'Share your celebration details and we will craft a one-of-a-kind cake for you.',
    name: 'Name',
    email: 'Email',
    eventDate: 'Event Date',
    description: 'Cake Description',
    budget: 'Approximate Budget',
    submit: 'Request Quote',
    placeholder: 'Tell me about your ideal cake...',
    whatsapp: 'Contact via WhatsApp',
    whatsappLead: '💬 You can also contact me directly via WhatsApp',
    subject: 'New cake quote request (EN)',
    budgetOptions: [
      { value: '', text: 'Select a range' },
      { value: '50-100', text: '$50 - $100 USD' },
      { value: '100-200', text: '$100 - $200 USD' },
      { value: '200-300', text: '$200 - $300 USD' },
      { value: '300+', text: '$300+ USD' }
    ],
    whatsappMessage: "Hi, I'm interested in getting a quote for a custom cake"
  }
} as const;

const t = labels[lang];
const thankYouPath = `${Astro.url.origin}${lang === 'en' ? '/en' : ''}/gracias`;
---

<section id={lang === 'es' ? 'contacto' : 'contact'} class="py-20 px-6 md:px-10">
  <div class="mx-auto max-w-4xl text-center">
    <p class="text-sm uppercase tracking-[0.3em] text-gold-accent">{t.heading}</p>
    <h2 class="mt-3 text-4xl font-serif font-bold text-warm-brown md:text-5xl">{title}</h2>
    <p class="mt-4 text-base text-gray-600">{t.intro}</p>
  </div>

  <form
    class="mx-auto mt-10 max-w-3xl space-y-6 rounded-3xl border border-white/60 bg-white/90 p-8 shadow-xl backdrop-blur-sm md:p-12"
    method="POST"
    action="https://formspree.io/f/YOUR_FORM_ID"
    data-form="contact"
  >
    <input type="hidden" name="_language" value={lang} />
    <input type="hidden" name="_subject" value={t.subject} />
    <input type="hidden" name="_next" value={thankYouPath} />

    <div class="grid gap-6 md:grid-cols-2">
      <div class="space-y-2">
        <label for="name" class="text-sm font-medium uppercase tracking-wide text-warm-brown">
          {t.name} <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="w-full rounded-xl border border-white/70 bg-cream/80 px-4 py-3 text-sm text-text-primary shadow-inner focus:border-gold-accent focus:outline-none focus:ring-2 focus:ring-gold-accent/40"
        />
      </div>

      <div class="space-y-2">
        <label for="email" class="text-sm font-medium uppercase tracking-wide text-warm-brown">
          {t.email} <span class="text-red-500">*</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full rounded-xl border border-white/70 bg-cream/80 px-4 py-3 text-sm text-text-primary shadow-inner focus:border-gold-accent focus:outline-none focus:ring-2 focus:ring-gold-accent/40"
        />
      </div>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <div class="space-y-2">
        <label for="event-date" class="text-sm font-medium uppercase tracking-wide text-warm-brown">
          {t.eventDate}
        </label>
        <input
          type="date"
          id="event-date"
          name="event-date"
          class="w-full rounded-xl border border-white/70 bg-cream/80 px-4 py-3 text-sm text-text-primary shadow-inner focus:border-gold-accent focus:outline-none focus:ring-2 focus:ring-gold-accent/40"
        />
      </div>

      <div class="space-y-2">
        <label for="budget" class="text-sm font-medium uppercase tracking-wide text-warm-brown">
          {t.budget}
        </label>
        <select
          id="budget"
          name="budget"
          class="w-full rounded-xl border border-white/70 bg-cream/80 px-4 py-3 text-sm text-text-primary shadow-inner focus:border-gold-accent focus:outline-none focus:ring-2 focus:ring-gold-accent/40"
        >
          {t.budgetOptions.map((option) => (
            <option value={option.value}>{option.text}</option>
          ))}
        </select>
      </div>
    </div>

    <div class="space-y-2">
      <label for="description" class="text-sm font-medium uppercase tracking-wide text-warm-brown">
        {t.description} <span class="text-red-500">*</span>
      </label>
      <textarea
        id="description"
        name="description"
        rows="4"
        required
        class="w-full rounded-2xl border border-white/70 bg-cream/80 px-4 py-3 text-sm text-text-primary shadow-inner focus:border-gold-accent focus:outline-none focus:ring-2 focus:ring-gold-accent/40 resize-none"
        placeholder={t.placeholder}
      ></textarea>
    </div>

    <button
      type="submit"
      class="w-full rounded-full bg-gold-accent py-3 text-sm font-semibold uppercase tracking-wide text-white shadow-lg transition-all duration-200 hover:-translate-y-0.5 hover:bg-gold-hover hover:shadow-xl"
    >
      {t.submit}
    </button>

    <div class="text-center text-sm text-gray-600">
      <p>{t.whatsappLead}</p>
      <a
        href={`https://wa.me/1234567890?text=${encodeURIComponent(t.whatsappMessage)}`}
        class="mt-2 inline-flex items-center justify-center text-gold-accent transition-colors duration-200 hover:text-gold-hover"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t.whatsapp}
      </a>
    </div>
  </form>
</section>

<script>
  // Form validation and submission handling
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.querySelector('[data-form="contact"]');
    if (!form) return;

    form.addEventListener('submit', () => {
      const submitButton = form.querySelector('button[type="submit"]');
      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent =
          submitButton.textContent?.includes('Solicitar') ? 'Enviando...' : 'Sending...';
      }
    });

    const requiredFields = form.querySelectorAll('[required]');
    requiredFields.forEach((field) => {
      field.addEventListener('blur', () => {
        const input = field;
        if (!input.value.trim()) {
          input.classList.add('border-red-500');
          input.classList.remove('border-white/70');
        } else {
          input.classList.remove('border-red-500');
          input.classList.add('border-white/70');
        }
      });
    });
  });
</script>
