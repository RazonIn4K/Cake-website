---
import ResponsiveImage from './ResponsiveImage.astro';

export interface Props {
  testimonials: any[];
  lang: 'es' | 'en';
}

const { testimonials, lang } = Astro.props;

// Sort testimonials - featured first, then by date
const sortedTestimonials = testimonials.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

const texts = {
  es: {
    title: "Lo Que Dicen Nuestros Clientes",
    subtitle: "Testimonios reales de celebraciones especiales en nuestra comunidad local",
    readMore: "Leer más",
    readLess: "Leer menos",
    occasion: "Ocasión",
    location: "Ubicación",
    rating: "Calificación"
  },
  en: {
    title: "What Our Customers Say",
    subtitle: "Real testimonials from special celebrations in our local community", 
    readMore: "Read more",
    readLess: "Read less",
    occasion: "Occasion",
    location: "Location",
    rating: "Rating"
  }
};

const t = texts[lang];

// Function to format date
const formatDate = (date: Date, lang: string) => {
  return new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-US', {
    year: 'numeric',
    month: 'long'
  }).format(new Date(date));
};

// Function to generate star rating
const generateStars = (rating: number) => {
  return '⭐'.repeat(rating);
};
---

<!-- Customer Testimonials Section -->
<section class="px-6 py-20 bg-gradient-to-br from-soft-pink/10 via-cream/30 to-warm-cream/20 md:px-12" id="testimonials">
  <div class="mx-auto max-w-6xl">
    
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-3xl font-serif font-bold text-warm-brown md:text-4xl mb-4">
        {t.title}
      </h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        {t.subtitle}
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sortedTestimonials.map((testimonial, index) => (
        <div class={`group relative overflow-hidden rounded-2xl bg-white shadow-xl transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl ${testimonial.data.featured ? 'ring-2 ring-gold-accent/50' : ''}`}>
          
          <!-- Featured Badge -->
          {testimonial.data.featured && (
            <div class="absolute top-4 right-4 z-10">
              <span class="inline-flex items-center rounded-full bg-gold-accent px-3 py-1 text-xs font-medium text-white shadow-lg">
                ⭐ {lang === 'es' ? 'Destacado' : 'Featured'}
              </span>
            </div>
          )}

          <!-- Cake Photo (if available) -->
          {testimonial.data.cakePhoto && (
            <div class="aspect-video overflow-hidden">
              <ResponsiveImage
                src={testimonial.data.cakePhoto}
                alt={`${lang === 'es' ? 'Pastel para' : 'Cake for'} ${testimonial.data.occasion}`}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
                loading={index < 2 ? 'eager' : 'lazy'}
                decoding="async"
                sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
                width={400}
                height={225}
              />
            </div>
          )}

          <!-- Testimonial Content -->
          <div class="p-6">
            
            <!-- Rating -->
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center">
                <span class="text-lg mr-2">{generateStars(testimonial.data.rating)}</span>
                <span class="text-sm text-gray-600">
                  {testimonial.data.rating}/5
                </span>
              </div>
              <span class="text-xs text-gray-500">
                {formatDate(testimonial.data.date, lang)}
              </span>
            </div>

            <!-- Testimonial Text -->
            <blockquote class="text-gray-700 mb-6 leading-relaxed">
              <span class="text-2xl text-gold-accent leading-none">"</span>
              <span class="testimonial-content" data-full-text={testimonial.data.content}>
                {testimonial.data.content.length > 150 
                  ? testimonial.data.content.substring(0, 150) + '...'
                  : testimonial.data.content
                }
              </span>
              <span class="text-2xl text-gold-accent leading-none">"</span>
              
              {testimonial.data.content.length > 150 && (
                <button 
                  class="read-more-btn text-warm-brown text-sm font-medium hover:text-gold-accent transition-colors ml-2"
                  onclick="toggleTestimonial(this)"
                >
                  {t.readMore}
                </button>
              )}
            </blockquote>

            <!-- Customer Info -->
            <div class="border-t border-gray-100 pt-4">
              <div class="flex items-center justify-between">
                <div>
                  <p class="font-semibold text-warm-brown">
                    {testimonial.data.customerName}
                  </p>
                  <p class="text-sm text-gray-600">
                    {testimonial.data.location}
                  </p>
                </div>
                <div class="text-right">
                  <p class="text-sm font-medium text-warm-brown">
                    {testimonial.data.occasion}
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Call to Action -->
    <div class="text-center mt-16">
      <div class="bg-white rounded-2xl p-8 shadow-xl max-w-2xl mx-auto">
        <h3 class="text-2xl font-serif font-bold text-warm-brown mb-4">
          {lang === 'es' 
            ? '¿Listo para crear tu próximo recuerdo dulce?' 
            : 'Ready to create your next sweet memory?'
          }
        </h3>
        <p class="text-gray-600 mb-6">
          {lang === 'es'
            ? 'Únete a nuestros clientes satisfechos y haz de tu celebración algo inolvidable.'
            : 'Join our satisfied customers and make your celebration unforgettable.'
          }
        </p>
        <a
          href={lang === 'es' ? '#pedido-personalizado' : '#custom-order'}
          class="inline-flex items-center justify-center rounded-full bg-gradient-to-r from-warm-brown to-gold-accent px-8 py-4 text-base font-semibold text-white transition-all duration-300 hover:from-gold-accent hover:to-warm-brown hover:shadow-lg"
        >
          <span class="mr-2">🎂</span>
          {lang === 'es' ? 'Solicitar Mi Pastel' : 'Order My Cake'}
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // Function to toggle testimonial text
  function toggleTestimonial(button) {
    const content = button.parentElement.querySelector('.testimonial-content');
    const fullText = content.getAttribute('data-full-text');
    const isExpanded = button.textContent.includes('menos') || button.textContent.includes('less');
    
    if (isExpanded) {
      // Collapse
      content.textContent = fullText.substring(0, 150) + '...';
      button.textContent = button.textContent.includes('menos') ? 'Leer más' : 'Read more';
    } else {
      // Expand
      content.textContent = fullText;
      button.textContent = button.textContent.includes('más') ? 'Leer menos' : 'Read less';
    }
  }

  // Make function globally available
  window.toggleTestimonial = toggleTestimonial;
</script>
