---
export interface Props {
  offerings: any[];
  lang: 'es' | 'en';
}

const { offerings, lang } = Astro.props;

const texts = {
  es: {
    title: "También Disponible",
    subtitle: "Complementa tu experiencia con nuestros recursos adicionales",
    disclaimer: "Estos recursos complementan nuestro servicio principal de pasteles personalizados",
    backToCakes: "Ver Pasteles Personalizados",
    learnMore: "Más información"
  },
  en: {
    title: "Also Available", 
    subtitle: "Complement your experience with our additional resources",
    disclaimer: "These resources complement our main custom cake service",
    backToCakes: "View Custom Cakes",
    learnMore: "Learn more"
  }
};

const t = texts[lang];

// Sort offerings by order
const sortedOfferings = offerings.sort((a, b) => a.data.order - b.data.order);
---

<!-- Secondary Offerings Section - Clearly positioned as complementary -->
<section class="px-6 py-16 bg-gradient-to-br from-gray-50 to-gray-100/50 md:px-12" id="secondary-offerings">
  <div class="mx-auto max-w-5xl">
    
    <!-- Section Header - Clearly secondary positioning -->
    <div class="text-center mb-12">
      <h2 class="text-2xl font-serif font-bold text-gray-700 md:text-3xl mb-3">
        {t.title}
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto mb-6">
        {t.subtitle}
      </p>
      
      <!-- Disclaimer - Makes it clear this is secondary -->
      <div class="bg-white/80 rounded-lg p-4 text-sm text-gray-600 border border-gray-200 max-w-3xl mx-auto">
        <p class="flex items-center justify-center">
          <span class="mr-2">ℹ️</span>
          {t.disclaimer}
        </p>
      </div>
    </div>

    <!-- Offerings Grid - Smaller, less prominent than main cake gallery -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      {sortedOfferings.map((offering) => (
        <div class="bg-white rounded-xl shadow-md hover:shadow-lg transition-all duration-300 overflow-hidden border border-gray-200">
          
          <!-- Offering Content -->
          <div class="p-6">
            
            <!-- Type Badge -->
            <div class="flex items-center justify-between mb-4">
              <span class={`inline-flex items-center rounded-full px-3 py-1 text-xs font-medium ${
                offering.data.type === 'digital' 
                  ? 'bg-blue-100 text-blue-800' 
                  : 'bg-green-100 text-green-800'
              }`}>
                {offering.data.type === 'digital' 
                  ? (lang === 'es' ? '📱 Digital' : '📱 Digital')
                  : (lang === 'es' ? '🎓 Taller' : '🎓 Workshop')
                }
              </span>
              
              {offering.data.price && (
                <span class="text-lg font-bold text-gray-700">
                  ${offering.data.price} USD
                </span>
              )}
            </div>

            <!-- Title and Description -->
            <h3 class="text-xl font-serif font-bold text-gray-800 mb-3">
              {offering.data.title}
            </h3>
            
            <p class="text-gray-600 mb-4 leading-relaxed">
              {offering.data.description}
            </p>

            <!-- PPP Notes (if available) -->
            {offering.data.pppNotes && (
              <p class="text-sm text-gray-500 mb-4 italic">
                {offering.data.pppNotes}
              </p>
            )}

            <!-- Action Button - Less prominent than main cake CTAs -->
            <div class="flex items-center justify-between">
              <a
                href={offering.data.buttonLink}
                target={offering.data.buttonAction === 'whatsapp' ? '_blank' : '_self'}
                rel={offering.data.buttonAction === 'whatsapp' ? 'noopener noreferrer' : ''}
                class="inline-flex items-center justify-center rounded-lg bg-gray-600 hover:bg-gray-700 px-6 py-2 text-sm font-medium text-white transition-colors duration-300"
              >
                <span class="mr-2">
                  {offering.data.buttonAction === 'whatsapp' ? '💬' : 
                   offering.data.buttonAction === 'gumroad' ? '🛒' : '📧'}
                </span>
                {offering.data.buttonText}
              </a>
              
              <span class="text-xs text-gray-500">
                {t.learnMore}
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Back to Main Service CTA -->
    <div class="text-center">
      <div class="bg-gradient-to-r from-warm-brown/10 to-gold-accent/10 rounded-xl p-8 border border-warm-brown/20">
        <h3 class="text-xl font-serif font-bold text-warm-brown mb-3">
          {lang === 'es' 
            ? '¿Listo para tu pastel personalizado?' 
            : 'Ready for your custom cake?'
          }
        </h3>
        <p class="text-gray-600 mb-6">
          {lang === 'es'
            ? 'Nuestro servicio principal son los pasteles artesanales hechos a medida para tu ocasión especial.'
            : 'Our main service is artisan cakes made to order for your special occasion.'
          }
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a
            href={lang === 'es' ? '#pedido-personalizado' : '#custom-order'}
            class="inline-flex items-center justify-center rounded-full bg-warm-brown px-8 py-3 text-base font-semibold text-white transition-all duration-300 hover:bg-warm-brown/90 hover:shadow-lg"
          >
            <span class="mr-2">🎂</span>
            {lang === 'es' ? 'Solicitar Pastel Personalizado' : 'Order Custom Cake'}
          </a>
          
          <a
            href="#cake-gallery"
            class="inline-flex items-center justify-center rounded-full border-2 border-warm-brown px-8 py-3 text-base font-medium text-warm-brown transition-all duration-300 hover:bg-warm-brown hover:text-white"
          >
            {t.backToCakes}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>