---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../content/config';

interface Props {
  item: CollectionEntry<'gallery'>;
  locale: Locale;
}

const { item, locale } = Astro.props as Props;
const { data } = item;
const fallbackNotice = !data.locale || data.locale === locale ? null : locale === 'es' ? 'Mostrando traducción alternativa' : 'Showing alternate locale';
---
<figure class="lg-card group overflow-hidden transition-transform hover:-translate-y-1">
  <div class="aspect-[4/3] overflow-hidden border-b-2 border-ink bg-cream-deep">
    <img
      src={data.image}
      alt={data.alt}
      loading="lazy"
      class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04]"
    />
  </div>
  <figcaption class="p-5">
    <div class="flex items-center justify-between gap-3">
      <h3 class="font-display text-lg font-bold text-ink">{data.title}</h3>
      <span class="lg-tag bg-sun-soft text-ink">{data.category}</span>
    </div>
    <p class="mt-2 text-sm font-medium leading-6 text-ink-soft">
      <slot name="description" />
    </p>
    {fallbackNotice && (
      <p class="mt-3 text-xs font-bold uppercase tracking-wide text-coral-deep">{fallbackNotice}</p>
    )}
  </figcaption>
</figure>
